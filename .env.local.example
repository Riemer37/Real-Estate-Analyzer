# ── Clerk (https://dashboard.clerk.com) ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret (maak aan via Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs (standaard werken deze)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/pricing

# ── Stripe (https://dashboard.stripe.com) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret (maak aan via Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Maak twee recurring prices aan in Stripe Dashboard:
STRIPE_PRO_MONTHLY_PRICE_ID=price_...   # €19/maand
STRIPE_PRO_ANNUAL_PRICE_ID=price_...    # €149/jaar

# ── App URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (al bestaand) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
